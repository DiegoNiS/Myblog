---
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-3 sm:px-6 py-2.5 sm:py-4">
    <nav class="glass-panel rounded-2xl sm:rounded-full px-4 sm:px-6 py-2.5 sm:py-3 flex flex-col sm:flex-row items-center justify-between gap-2.5 sm:gap-4 border border-white/10 shadow-2xl">
      
      <!-- Fila Superior en Móvil: Logo + Toggle Menu + Status minimalista -->
      <div class="w-full sm:w-auto flex items-center justify-between">
        <!-- Brand Logo / Domain -->
        <a href="#" class="flex items-center gap-2 sm:gap-3 group shrink-0">
          <div class="relative w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-gradient-to-tr from-orange-600 via-orange-500 to-amber-400 p-[1px] flex items-center justify-center">
            <div class="w-full h-full bg-neutral-950 rounded-full flex items-center justify-center text-xs font-mono font-bold text-orange-400 group-hover:bg-neutral-900 transition-colors">
              D
            </div>
          </div>
          <span class="font-bold tracking-tight text-white group-hover:text-orange-400 transition-colors text-xs sm:text-base">
            dante<span class="text-orange-500">.duhvia.com</span>
          </span>
        </a>

        <!-- Botón Menú Hamburguesa en Móvil -->
        <button 
          id="mobile-menu-btn" 
          aria-label="Abrir menú de navegación"
          class="sm:hidden p-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:text-white hover:bg-white/10 transition-colors"
        >
          <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Status Indicator (Desktop only) -->
      <div class="hidden lg:flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-slate-400 font-mono">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
        </span>
        UNSA • Co-founder @ Duhvia
      </div>

      <!-- Navigation Links Simplificados & Categorizados -->
      <div 
        id="mobile-menu" 
        class="hidden sm:flex flex-col sm:flex-row items-center gap-3 sm:gap-5 md:gap-6 w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-white/10 text-xs md:text-sm font-medium text-slate-300 transition-all"
      >
        <a href="#about" class="nav-link hover:text-orange-400 transition-colors py-1 w-full sm:w-auto text-center sm:text-left">Sobre Mí</a>
        
        <!-- Categoría 1: Historias & Proyectos -->
        <a href="#hackathon" class="nav-link hover:text-orange-400 transition-colors py-1 w-full sm:w-auto text-center sm:text-left">Proyectos & Hackathon</a>
        
        <!-- Categoría 2: Vida & Filosofía -->
        <a href="#philosophy" class="nav-link hover:text-orange-400 transition-colors py-1 w-full sm:w-auto text-center sm:text-left">Filosofía & Amigos</a>
        
        <!-- Categoría 3: Cultura & Vibe -->
        <a href="#vibes" class="nav-link hover:text-orange-400 transition-colors py-1 w-full sm:w-auto text-center sm:text-left">Cultura & Lifestyle</a>
        
        <!-- Destacado: Mensajes Anónimos -->
        <a href="#anonymous" class="nav-link hover:text-orange-400 transition-colors text-orange-400 font-semibold py-1 w-full sm:w-auto text-center sm:text-left">Anónimo 🔒</a>

        <a href="https://duhvia.com" target="_blank" rel="noopener noreferrer" class="px-3.5 py-1.5 rounded-full bg-orange-500/10 hover:bg-orange-500/20 text-orange-400 border border-orange-500/30 transition-all font-mono text-xs text-center w-full sm:w-auto mt-1 sm:mt-0 hidden md:inline-block">
          Duhvia ↗
        </a>
      </div>

    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');
    const navLinks = document.querySelectorAll('.nav-link');

    menuBtn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
      openIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    });

    // Cerrar menú al hacer clic en un enlace en móvil
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 640) {
          menu?.classList.add('hidden');
          openIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }
      });
    });
  });
</script>
