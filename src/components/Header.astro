---
const navItems = [
  { label: "Sobre Mí", href: "#about" },
  { label: "Hackathon Nexia 🏆", href: "#hackathon" },
  { label: "Filosofía & Pensamientos", href: "#philosophy" },
  { label: "Amigos & Lealtad", href: "#relationships" },
  { label: "Cultura & Cine", href: "#vibes" },
  { label: "Lifestyle", href: "#lifestyle" },
  { label: "Raw thought.md 📄", href: "#thought-file" },
  { label: "Mensaje Anónimo 🔒", href: "#anonymous", highlight: true }
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 sm:py-4">
    <nav class="glass-panel rounded-full px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between border border-white/10 shadow-2xl relative">
      
      <!-- Brand Logo / Domain -->
      <a href="#" class="flex items-center gap-3 group shrink-0">
        <div class="relative w-8 h-8 rounded-full bg-gradient-to-tr from-orange-600 via-orange-500 to-amber-400 p-[1px] flex items-center justify-center">
          <div class="w-full h-full bg-neutral-950 rounded-full flex items-center justify-center text-xs font-mono font-bold text-orange-400 group-hover:bg-neutral-900 transition-colors">
            D
          </div>
        </div>
        <span class="font-bold tracking-tight text-white group-hover:text-orange-400 transition-colors text-sm sm:text-base">
          dante<span class="text-orange-500">.duhvia.com</span>
        </span>
      </a>

      <!-- Status Badge Center (Desktop) -->
      <div class="hidden lg:flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-slate-400 font-mono">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
        </span>
        UNSA • Co-founder @ Duhvia
      </div>

      <!-- Acceso Directo + Botón de Menú Overlay Ultra Limpio -->
      <div class="flex items-center gap-3">
        
        <a href="https://duhvia.com" target="_blank" rel="noopener noreferrer" class="px-3.5 py-1.5 rounded-full bg-orange-500/10 hover:bg-orange-500/20 text-orange-400 border border-orange-500/30 transition-all font-mono text-xs hidden sm:inline-block">
          Duhvia ↗
        </a>

        <!-- Trigger de Menú Overlay Cinemático -->
        <button 
          id="menu-toggle-btn" 
          aria-label="Abrir Menú"
          class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-mono text-slate-200 transition-all cursor-pointer group"
        >
          <span class="text-slate-400 group-hover:text-white transition-colors">Menú</span>
          <span class="w-2 h-2 rounded-full bg-orange-500 group-hover:scale-125 transition-transform"></span>
        </button>

      </div>

    </nav>
  </div>

  <!-- Overlay Flotante Cinemático de Navegación (Desplegable para todas las pantallas) -->
  <div 
    id="nav-overlay" 
    class="fixed inset-0 bg-neutral-950/95 backdrop-blur-2xl z-50 flex flex-col justify-between p-8 sm:p-12 opacity-0 pointer-events-none transition-all duration-400 border-b border-white/10"
  >
    <!-- Header del Overlay -->
    <div class="flex items-center justify-between max-w-5xl mx-auto w-full">
      <span class="text-xs font-mono text-orange-400 uppercase tracking-widest">// Navegación del Sitio</span>
      
      <button 
        id="menu-close-btn"
        class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-slate-200 text-xs font-mono border border-white/10 transition-colors cursor-pointer"
      >
        Cerrar [✕]
      </button>
    </div>

    <!-- Lista de Enlaces Principales -->
    <div class="max-w-5xl mx-auto w-full py-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {navItems.map((item, idx) => (
          <a 
            href={item.href} 
            class="overlay-link group p-4 sm:p-5 rounded-2xl glass-card border border-white/5 hover:border-orange-500/40 flex items-center justify-between transition-all"
          >
            <div class="flex items-center gap-4">
              <span class="font-mono text-xs text-orange-500/70 group-hover:text-orange-400">0{idx + 1}</span>
              <span class={`text-lg sm:text-2xl font-bold tracking-tight transition-colors ${item.highlight ? 'text-orange-400' : 'text-slate-200 group-hover:text-white'}`}>
                {item.label}
              </span>
            </div>
            <span class="text-slate-500 group-hover:text-orange-400 group-hover:translate-x-1 transition-all">→</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Footer del Overlay -->
    <div class="max-w-5xl mx-auto w-full flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs font-mono text-slate-400">
      <span>dante.duhvia.com</span>
      <span>UNSA • Co-fundador @ Duhvia</span>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('menu-toggle-btn');
    const closeBtn = document.getElementById('menu-close-btn');
    const overlay = document.getElementById('nav-overlay');
    const overlayLinks = document.querySelectorAll('.overlay-link');

    function openMenu() {
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      overlay?.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      overlay?.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
    }

    toggleBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);

    overlayLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  });
</script>
