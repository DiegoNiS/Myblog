---
import PlaceholderImage from './PlaceholderImage.astro';

const socialLinks = [
  {
    name: "GitHub",
    label: "@DiegoNiS",
    href: "https://github.com/DiegoNiS",
    icon: "💻",
    color: "hover:border-purple-500/50 hover:text-purple-400"
  },
  {
    name: "LinkedIn",
    label: "Diego Nina",
    href: "https://www.linkedin.com/in/diego-claudio-nina-suyo-14206335b/",
    icon: "💼",
    color: "hover:border-sky-500/50 hover:text-sky-400"
  },
  {
    name: "WhatsApp",
    label: "+51 960 335 622",
    href: "https://wa.me/51960335622?text=Hola%20Dante,%20vengo%20desde%20tu%20sitio%20web",
    icon: "💬",
    color: "hover:border-emerald-500/50 hover:text-emerald-400"
  },
  {
    name: "Instagram",
    label: "@dantnt7",
    href: "https://www.instagram.com/dantnt7",
    icon: "📸",
    color: "hover:border-pink-500/50 hover:text-pink-400"
  },
  {
    name: "TikTok",
    label: "@dantnt7",
    href: "https://www.tiktok.com/@dantnt7",
    icon: "🎵",
    color: "hover:border-cyan-500/50 hover:text-cyan-400"
  },
  {
    name: "Facebook",
    label: "Diego Nina",
    href: "https://www.facebook.com/diego.nina.12720",
    icon: "👤",
    color: "hover:border-blue-500/50 hover:text-blue-400"
  }
];
---

<section class="relative min-h-screen flex flex-col justify-center pt-20 sm:pt-28 pb-12 sm:pb-16 px-4 sm:px-6 overflow-hidden">
  <!-- Glow cinemático de fondo -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[600px] h-[250px] sm:h-[350px] bg-orange-600/10 rounded-full blur-[100px] sm:blur-[140px] pointer-events-none"></div>
  <div class="absolute bottom-10 right-0 sm:right-10 w-[250px] sm:w-[400px] h-[200px] sm:h-[300px] bg-red-900/10 rounded-full blur-[100px] sm:blur-[120px] pointer-events-none"></div>

  <div class="max-w-5xl mx-auto w-full relative z-10 space-y-12">
    
    <!-- Grid Principal (Textos e Imagen limpia) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Columna Izquierda: Textos Hero -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Badge de Apertura -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-mono tracking-wider uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
          Ingeniería de Sistemas & Agencia Duhvia
        </div>

        <!-- Texto Principal Obligatorio -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.15]">
          Hola, soy Dante. Encuentro belleza en una tarde nublada y en un código que compila a la primera.
        </h1>

        <!-- Subtexto Obligatorio -->
        <p class="text-lg md:text-xl text-slate-300 font-normal leading-relaxed border-l-2 border-orange-500/40 pl-4 py-1 italic">
          "Automatizo lo complejo, diseño soluciones y disfruto de la melancolía cinemática. 'Cause it's too cold for you here..."
        </p>

        <!-- Botones de Acción Principales -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a href="#about" class="px-6 py-3 rounded-full bg-gradient-to-r from-orange-600 to-orange-500 hover:from-orange-500 hover:to-amber-500 text-white font-medium text-sm transition-all shadow-lg shadow-orange-950/40 hover:shadow-orange-500/25 flex items-center gap-2">
            Explorar Portafolio
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>

          <a href="https://duhvia.com" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-full glass-panel hover:bg-white/10 text-slate-200 font-medium text-sm transition-all border border-white/10 flex items-center gap-2">
            Visitar Duhvia
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Foto + Nota Personal compacta abajo -->
      <div class="lg:col-span-5 flex flex-col items-center">
        <div class="w-full max-w-sm lg:max-w-none space-y-4">
          
          <!-- Retrato Principal -->
          <div class="relative">
            <div class="absolute -inset-1 rounded-2xl bg-gradient-to-b from-orange-500/20 via-transparent to-red-500/10 blur-lg opacity-70"></div>
            <div class="relative glass-card p-3 rounded-2xl">
              <PlaceholderImage 
                src="/assets/dante-hero.jpg"
                alt="Foto de perfil o retrato cinemático de Dante en plano medio con iluminación tenue al atardecer"
                title="Retrato Cinemático Principal (Dante)"
                badge="Dante's Portrait"
                aspectRatio="aspect-[4/5]"
              />
            </div>
          </div>

          <!-- Nota Personal (Bajo la foto, limpia y elegante) -->
          <div class="glass-panel p-3.5 rounded-xl border border-white/10 bg-neutral-950/60 text-left">
            <div class="flex items-start gap-2.5">
              <!-- <span class="text-orange-500 text-sm select-none mt-0.5">⚡</span> -->
              <p class="text-xs text-slate-300 leading-relaxed font-light">
                <span class="text-orange-400 font-mono font-medium">Nota:</span> Este es mi sitio personal, así que pongo lo que me apetece. Intentaré actualizarlo constantemente colocando cosas muy mías ya que, repito: <span class="text-white font-semibold decoration-orange-500 decoration-1">es MI sitio</span>.
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Carrusel Ticker Infinito Discreto (Redes Sociales) -->
    <div class="pt-4 border-t border-white/5 space-y-3 text-center overflow-hidden">
      <span class="text-[11px] font-mono text-slate-500 uppercase tracking-widest block">Contacto directo & Redes:</span>
      
      <div class="relative w-full overflow-hidden py-2 mask-linear-gradient">
        <div class="animate-infinite-marquee gap-3">
          <!-- Primer grupo de links -->
          {socialLinks.map((social) => (
            <a 
              href={social.href} 
              target="_blank" 
              rel="noopener noreferrer"
              class={`px-4 py-2 rounded-full glass-panel text-slate-300 border border-white/10 text-xs font-medium transition-all flex items-center gap-2 hover:scale-105 shrink-0 ${social.color}`}
            >
              <span>{social.icon}</span>
              <span>{social.name}:</span>
              <span class="font-mono text-slate-400">{social.label}</span>
            </a>
          ))}
          <!-- Duplicado para loop infinito sin saltos -->
          {socialLinks.map((social) => (
            <a 
              href={social.href} 
              target="_blank" 
              rel="noopener noreferrer"
              class={`px-4 py-2 rounded-full glass-panel text-slate-300 border border-white/10 text-xs font-medium transition-all flex items-center gap-2 hover:scale-105 shrink-0 ${social.color}`}
            >
              <span>{social.icon}</span>
              <span>{social.name}:</span>
              <span class="font-mono text-slate-400">{social.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Ocultar barra de scroll para el carrusel manteniendo funcionalidad de deslizamiento */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
