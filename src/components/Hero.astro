---
import PlaceholderImage from './PlaceholderImage.astro';

const socialLinks = [
  {
    name: "GitHub",
    label: "@DiegoNiS",
    href: "https://github.com/DiegoNiS",
    icon: "💻",
    color: "hover:border-purple-500/50 hover:text-purple-400"
  },
  {
    name: "LinkedIn",
    label: "Diego Nina",
    href: "https://www.linkedin.com/in/diego-claudio-nina-suyo-14206335b/",
    icon: "💼",
    color: "hover:border-sky-500/50 hover:text-sky-400"
  },
  {
    name: "WhatsApp",
    label: "+51 960 335 622",
    href: "https://wa.me/51960335622?text=Hola%20Dante,%20vengo%20desde%20tu%20sitio%20web",
    icon: "💬",
    color: "hover:border-emerald-500/50 hover:text-emerald-400"
  },
  {
    name: "Instagram",
    label: "@dantnt7",
    href: "https://www.instagram.com/dantnt7",
    icon: "📸",
    color: "hover:border-pink-500/50 hover:text-pink-400"
  },
  {
    name: "TikTok",
    label: "@dantnt7",
    href: "https://www.tiktok.com/@dantnt7",
    icon: "🎵",
    color: "hover:border-cyan-500/50 hover:text-cyan-400"
  },
  {
    name: "Facebook",
    label: "Diego Nina",
    href: "https://www.facebook.com/diego.nina.12720",
    icon: "👤",
    color: "hover:border-blue-500/50 hover:text-blue-400"
  }
];
---

<section class="relative min-h-screen flex items-center justify-center pt-28 pb-16 px-6 overflow-hidden">
  <!-- Glow cinemático de fondo -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-orange-600/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-[400px] h-[300px] bg-red-900/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-5xl mx-auto w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Columna Texto Hero -->
      <div class="lg:col-span-7 space-y-7 text-left">
        <!-- Badge de Apertura -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-mono tracking-wider uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
          Ingeniería de Sistemas & Agencia Duhvia
        </div>

        <!-- Texto Principal Obligatorio -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.15]">
          Hola, soy Dante. Encuentro belleza en una tarde nublada y en un código que compila a la primera.
        </h1>

        <!-- Subtexto Obligatorio -->
        <p class="text-lg md:text-xl text-slate-300 font-normal leading-relaxed border-l-2 border-orange-500/40 pl-4 py-1 italic">
          "Automatizo lo complejo, diseño soluciones y disfruto de la melancolía cinemática. 'Cause it's too cold for you here..."
        </p>

        <!-- Declaración Rebelde de Sitio Personal -->
        <div class="glass-panel p-4 rounded-xl border border-white/10 relative overflow-hidden bg-neutral-900/40">
          <div class="flex items-start gap-3">
            <span class="text-orange-500 text-lg select-none">⚡</span>
            <div class="space-y-1">
              <p class="text-xs font-mono text-orange-400 uppercase tracking-wider font-semibold">Nota personal / Reglas del sitio:</p>
              <p class="text-sm text-slate-200 leading-relaxed">
                Este es mi sitio y blog personal, así que voy a poner aquí todo lo que yo quiera y se me apetezca. Estaré actualizando todo este sitio más constantemente ya que, repito y recalco: <span class="text-white font-semibold underline decoration-orange-500 decoration-2">es MI sitio</span>.
              </p>
            </div>
          </div>
        </div>

        <!-- Redes Sociales / Contacto Directo -->
        <div class="pt-2 space-y-3">
          <span class="text-xs font-mono text-slate-400 uppercase tracking-widest block">Conecta conmigo o déjame un mensaje directo:</span>
          <div class="flex flex-wrap gap-2.5">
            {socialLinks.map((social) => (
              <a 
                href={social.href} 
                target="_blank" 
                rel="noopener noreferrer"
                class={`px-3.5 py-2 rounded-xl glass-panel text-slate-300 border border-white/10 text-xs font-medium transition-all flex items-center gap-2 ${social.color}`}
              >
                <span>{social.icon}</span>
                <span>{social.name}:</span>
                <span class="font-mono text-slate-400">{social.label}</span>
              </a>
            ))}
          </div>
        </div>

      </div>

      <!-- Columna Visual Hero (Retrato) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-sm lg:max-w-none">
          <!-- Marco sutil con iluminación -->
          <div class="absolute -inset-1 rounded-2xl bg-gradient-to-b from-orange-500/20 via-transparent to-red-500/10 blur-lg opacity-70"></div>
          
          <div class="relative glass-card p-3 rounded-2xl">
            <PlaceholderImage 
              src="/assets/dante-hero.jpg"
              alt="Foto de perfil o retrato cinemático de Dante en plano medio con iluminación tenue al atardecer"
              title="Retrato Cinemático Principal (Dante)"
              badge="Dante's Portrait"
              aspectRatio="aspect-[4/5]"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
