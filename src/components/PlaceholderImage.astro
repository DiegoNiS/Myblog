---
interface Props {
  src: string;
  alt: string;
  title: string;
  badge?: string;
  aspectRatio?: string;
}

const { src, alt, title, badge, aspectRatio = "aspect-[16/10]" } = Astro.props;
---

<div class={`relative group overflow-hidden rounded-xl border border-white/10 bg-neutral-900/60 ${aspectRatio}`}>
  <!-- Fallback/Placeholder Visual Estético -->
  <div class="absolute inset-0 bg-gradient-to-br from-neutral-900 via-neutral-950 to-black flex flex-col items-center justify-center p-6 text-center transition-transform duration-700 group-hover:scale-105">
    <!-- Icono cinematográfico de placeholder -->
    <div class="w-12 h-12 mb-3 rounded-full bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-400 group-hover:border-orange-500/40 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>
    
    <span class="text-xs font-mono uppercase tracking-widest text-orange-500/80 mb-1">{badge || "Foto Sugerida"}</span>
    <p class="text-sm text-slate-300 font-medium line-clamp-2 px-2">{title}</p>
    
    <div class="mt-3 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] font-mono text-slate-400 max-w-full truncate">
      Ruta: <span class="text-slate-200">{src}</span>
    </div>
  </div>

  <!-- Imagen real si el usuario coloca el archivo en public/assets -->
  <img 
    src={src} 
    alt={alt} 
    class="absolute inset-0 w-full h-full object-cover transition-all duration-700 group-hover:scale-105 opacity-0 group-has-[[data-loaded=true]]:opacity-100" 
    onload="this.setAttribute('data-loaded', 'true'); this.classList.remove('opacity-0');"
    onerror="this.style.display='none';"
  />

  <!-- Gradiente Cinemático de superposición -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none"></div>

  <!-- Tooltip/Badge de Instrucción de imagen (en hover) -->
  <div class="absolute inset-x-0 bottom-0 p-4 transform translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none">
    <div class="glass-panel p-2.5 rounded-lg text-xs text-slate-300 border border-orange-500/30">
      <span class="text-orange-400 font-semibold block mb-0.5">📸 Requisito de Foto:</span>
      <span class="text-slate-300 leading-tight block">{alt}</span>
    </div>
  </div>
</div>
