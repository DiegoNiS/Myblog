---
import fs from 'node:fs';
import path from 'node:path';

// Leer el contenido raw del archivo public/thought.md durante la compilación
let thoughtRawContent = '';
try {
  const filePath = path.join(process.cwd(), 'public', 'thought.md');
  thoughtRawContent = fs.readFileSync(filePath, 'utf-8');
} catch (e) {
  thoughtRawContent = '# thought.md\n\n> No se pudo cargar el archivo.';
}
---

<section id="thought-file" class="py-24 px-6 relative bg-neutral-950/95 border-t border-white/5 font-mono">
  <!-- Glow azul/púrpura cinemático estilo IDE -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-purple-600/5 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto relative z-10 space-y-6">
    
    <!-- Encabezado de Sección estilo GitHub File Viewer -->
    <div class="flex items-center justify-between border-b border-white/10 pb-4">
      <div class="flex items-center gap-3">
        <span class="text-xs text-orange-400 font-semibold tracking-wider uppercase">// raw_reader</span>
        <h2 class="text-lg font-bold text-white font-mono flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          thought.md
        </h2>
      </div>

      <div class="flex items-center gap-2 text-xs text-slate-400">
        <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-[11px]">
          GitHub Raw View
        </span>
        <a href="/thought.md" target="_blank" class="hover:text-orange-400 transition-colors text-[11px] underline">
          Raw ↗
        </a>
      </div>
    </div>

    <!-- Visor de Documento GitHub Estilo Terminal / Markdown Editor Raw -->
    <div class="glass-card rounded-2xl border border-white/10 overflow-hidden shadow-2xl bg-[#09090d]">
      
      <!-- Topbar del editor / archivo -->
      <div class="bg-neutral-900/80 px-4 py-2.5 border-b border-white/10 flex items-center justify-between text-xs text-slate-400">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
          <span class="ml-2 text-slate-300 font-sans">dante.duhvia.com/public/thought.md</span>
        </div>
        <span class="text-[11px] text-slate-500">UTF-8 • Markdown</span>
      </div>

      <!-- Cuerpo del Archivo (Visualización en crudo con resaltado de sintaxis Markdown) -->
      <div class="p-6 md:p-8 overflow-x-auto text-xs md:text-sm leading-relaxed text-slate-300 whitespace-pre-wrap font-mono">
        <div class="space-y-1" id="md-rendered-raw">
          {thoughtRawContent.split('\n').map((line, idx) => {
            const lineNum = idx + 1;
            let formattedLine = line;

            // Renderizado de sintaxis Markdown manteniendo el texto intacto
            const isHeading = line.startsWith('#');
            const isQuote = line.startsWith('>');
            const isList = /^\d+\./.test(line.trim());
            const isDivider = line.startsWith('---');

            return (
              <div class="flex items-start gap-4 hover:bg-white/[0.02] px-2 py-0.5 rounded transition-colors group">
                <span class="w-8 text-right select-none text-slate-600 text-[11px] shrink-0 font-mono group-hover:text-slate-400">{lineNum}</span>
                <span class={`flex-1 ${
                  isHeading ? 'text-orange-400 font-bold' : 
                  isQuote ? 'text-amber-300/90 italic' : 
                  isList ? 'text-purple-300' : 
                  isDivider ? 'text-slate-600 font-bold' : 'text-slate-200'
                }`}>
                  {line}
                </span>
              </div>
            );
          })}
        </div>
      </div>

    </div>

  </div>
</section>
