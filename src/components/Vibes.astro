---
import PlaceholderImage from './PlaceholderImage.astro';

const artists = [
  "The Neighbourhood",
  "The Strokes",
  "The Marías",
  "Patrick Watson",
  "Hozier",
  "Heartless Bastards"
];

const favorites = [
  { label: "Cine & Drama", item: "Películas Dramáticas / Épicas" },
  { label: "Series", item: "Game of Thrones - House of the Dragon" },
  { label: "Franquicia", item: "Monsterverse" },
  { label: "Filmografías", item: "Stephen Spielberg & Christopher Nolan" }
];
---

<section id="vibes" class="py-24 px-6 relative overflow-hidden">
  <!-- Fondo con degradado cinemático profundo -->
  <div class="absolute inset-0 bg-gradient-to-b from-black via-neutral-950/80 to-black pointer-events-none"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    
    <!-- Encabezado -->
    <div class="flex items-center gap-3 mb-12">
      <span class="text-orange-500 font-mono text-sm font-semibold tracking-wider uppercase">02 //</span>
      <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">Cultura & Vibes (Música y Cine)</h2>
      <div class="h-[1px] bg-white/10 flex-1 ml-4"></div>
    </div>

    <!-- Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
      
      <!-- Columna Principal: Texto y Player -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        
        <!-- Texto Principal Obligatorio -->
        <div class="glass-card p-8 rounded-2xl border border-white/10 relative">
          <div class="absolute -top-3 left-6 px-3 py-0.5 rounded-full bg-red-950/80 border border-red-500/30 text-[11px] font-mono text-red-400">
            Cinematic Soundtrack
          </div>

          <p class="text-lg md:text-l text-slate-200 leading-relaxed font-light pt-2">
            Puedo pasar el día entero en cama viendo un buen drama, algo épico... Game of Thrones, Star Wars o sobre el Monsterverse. Fan del realismo, de Ryan Gosling y Hugh Jackman. Mi soundtrack va desde The Strokes y The Marías, hasta The Neighbourhood, Patrick Watson y Hozier. Take me to church, o llévame a ver una buena película.
          </p>
        </div>

        <!-- Visual Soundtrack Player / Vinyl Aesthetic -->
        <div class="glass-panel p-6 rounded-2xl border border-white/10 flex flex-col sm:flex-row items-center gap-6">
          
          <!-- Vinyl Disc Graphic -->
          <div class="relative w-24 h-24 flex-shrink-0">
            <div class="w-full h-full rounded-full bg-neutral-900 border-4 border-neutral-800 flex items-center justify-center shadow-2xl animate-[spin_10s_linear_infinite]">
              <div class="w-10 h-10 rounded-full bg-orange-600/30 border border-orange-500/50 flex items-center justify-center">
                <div class="w-3 h-3 rounded-full bg-neutral-950"></div>
              </div>
            </div>
            <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-white/10 to-transparent pointer-events-none"></div>
          </div>

          <!-- Artist badges -->
          <div class="space-y-3 flex-1 text-center sm:text-left">
            <span class="text-xs font-mono text-slate-400 uppercase tracking-widest block">Artistas en Bucle:</span>
            <div class="flex flex-wrap gap-2 justify-center sm:justify-start">
              {artists.map((artist) => (
                <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-slate-300 font-medium hover:border-orange-500/40 hover:text-orange-300 transition-colors">
                  🎵 {artist}
                </span>
              ))}
            </div>
          </div>

        </div>

      </div>

      <!-- Columna Galería / Favorites -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        
        <!-- Grid de Favoritos de Cine -->
        <div class="grid grid-cols-2 gap-3">
          {favorites.map((fav) => (
            <div class="glass-panel p-4 rounded-xl border border-white/5">
              <span class="text-[10px] font-mono text-orange-400 uppercase tracking-wider block mb-1">{fav.label}</span>
              <span class="text-sm font-semibold text-slate-200 block">{fav.item}</span>
            </div>
          ))}
        </div>

        <!-- Image Placeholder de Cine / Melancolía -->
        <div class="glass-card p-3 rounded-2xl flex-1 flex flex-col justify-center">
          <PlaceholderImage 
            src="/assets/cine-vibes.jpg"
            alt="Fotografía cinemática en tonos fríos/atardecer evocando la atmósfera de Blade Runner o un drama melancólico"
            title="Atmósfera Cinemática & Cine"
            badge="Cultura & Vibes"
            aspectRatio="aspect-[16/9]"
          />
        </div>

      </div>

    </div>

  </div>
</section>
